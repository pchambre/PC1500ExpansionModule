(footprint "Pico2W-Socket"
	(version 20260206)
	(generator "pcbnew")
	(generator_version "10.0")
	(layer "F.Cu")
	(descr "Through-hole 40-pad socket pattern for the Raspberry Pi Pico 2 W module (2x20, 2.54mm pitch, 17.78mm row spacing, 1mm holes) -- dimensions confirmed directly from Raspberry Pi's own Pico 2 W Datasheet, Section 2 'Mechanical specification'/Figure 3 (51x21mm board, 40 pins on a 2.54mm grid, 1mm holes; row spacing = 21 - 2*1.61 = 17.78mm, cross-checked as exactly 7x0.1in and against the drawing's own 1.61mm margin callout). Intended for two 1x20 2.54mm female header sockets so the module is removable, not soldered directly.")
	(tags "raspberry pi pico 2 w socket connector")
