;
; screen_watch.pio -- BASIC's text buffers on the bus (screen_watch.h; the
; 2026-10-17 trial's program). GreenPAK2 IO12 raises PIN_SCREEN_TRIG for
; every ME0 write to 7000H-7FFFH, where BASIC keeps its text buffers and
; the LCD its dots -- the dongle's GPIO28 (a wire from J5 pin 2, in place
; of the SD bridge's INT), the card's GPIO24 (TRIG_WR_SYS). On each rising
; edge this takes one 24-bit sample of GPIO0-23 -- A0-A12 from GPIO0, the
; data bus at DATA_PIN_BASE (the dongle's GPIO13, the card's GPIO16) -- and
; autopushes it for the DMA ring. Inputs only: it never drives a pin, so it
; runs alongside the read and write paths on pio0/pio1.
;
; The delay before sampling roughly matches write_serve's ordinary write
; (trigger edge -> address SM -> data SM), which already latches window
; writes reliably. Tune it here if captured data looks a write behind.
.program screen_watch
.wrap_target
wait_high:
    jmp pin, high          ; PIN_SCREEN_TRIG (sm_config_set_jmp_pin) high: a write
    jmp wait_high
high:
    nop [11]               ; let the data bus settle, as write_serve's capture does
    in pins, 24            ; IN_BASE = GPIO0; autopush at 24
wait_low:
    jmp pin, wait_low      ; one sample per write: wait for the trigger to drop
.wrap

; When PIN_SCREEN_TRIG is out of GPIO0-31's reach (the RP2350B-Plus-W
; dongle, PC1500_TARGET=plusw: header pin 34 is GPIO42), no one PIO block
; sees both it and GPIO0-23 -- a block reaches only 32 consecutive GPIOs.
; screen_trig_relay watches the trigger on pio2 (GPIO base 16, as the
; CYW43 on GPIO36-39 needs anyway) and sets IRQ flag 4 of the next PIO
; block -- pio0, the ring wraps -- where screen_watch_irq samples the bus.
; screen_watch.c picks this pair or screen_watch above at compile time.
; The relay's own cycle or two comes off screen_watch_irq's delay.
.program screen_trig_relay
.pio_version 1
.wrap_target
relay_wait_high:
    jmp pin, relay_high    ; PIN_SCREEN_TRIG (sm_config_set_jmp_pin) high: a write
    jmp relay_wait_high
relay_high:
    irq next set 4         ; pio0's screen_watch_irq: sample now
relay_wait_low:
    jmp pin, relay_wait_low ; one signal per write: wait for the trigger to drop
.wrap

.program screen_watch_irq
.pio_version 1
.wrap_target
    wait 1 irq 4           ; from screen_trig_relay on pio2 (cleared by the wait)
    nop [9]                ; let the data bus settle, as write_serve's capture does
    in pins, 24            ; IN_BASE = GPIO0; autopush at 24
.wrap
