(footprint "Silabs_BGM220S"
	(version 20260206)
	(generator "pcbnew")
	(generator_version "10.0")
	(layer "F.Cu")
	(descr "Silicon Labs BGM220S Bluetooth LE SiP module, LGA-44 6x6x1.1mm, with its host-board antenna loop (BGM220SC22WGA2/SC22HNA2 coordinates). Datasheet Rev 1.4: land pattern 8.2, antenna 7.1 / Table 7.1 / Figures 7.2-7.3. Place the module 1.50 mm from the copper keep-in edge (the Dwgs.User line), at the middle of a long board edge; the antenna and that edge are on this footprint's left/top. No copper on any layer under the antenna or in its keepout area (rule areas BGM220S_ANTENNA_KEEPOUT_TOP/_LOWER). Pin 40 (ANT_OUT) drives the loop. https://www.silabs.com/documents/public/data-sheets/bgm220s-datasheet.pdf")
	(tags "BGM220S Silicon Labs EFR32BG22 Bluetooth BLE SiP module antenna")
