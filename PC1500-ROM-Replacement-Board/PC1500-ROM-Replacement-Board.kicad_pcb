	(footprint "Sharp-PC-Footprints:SHARP-PC-CARTRIDGE"
		(layer "F.Cu")
		(uuid "cd56c167-c7fa-4050-9d63-bc4ebce59014")
		(at 150 50 -90)
		(descr "Sharp PC-1500 40-pin card-edge cartridge slot contact fingers (SMD, front+back). Pad pitch/order sourced from https://github.com/kaibader/Sharp-PC-Breakout-Boards/tree/main/Breakout-Cartridge (CC BY-SA 4.0, Kai C. Bader); pad lengths set from real measurements of the connector. Edge.Cuts is a plain straight-sided tab, 26.3mm wide x 7.1mm deep -- no flared ears on the sides -- centered as a notch in the board's 31.9mm width, leaving margin on both sides. Pins 1/20/21/40 (VCC/VGG/GND/GND) are the long power pins: 7.1mm, reaching the true tip, so they mate first and break last. All other (signal) pins are 6.2mm, 0.9mm shorter, sharing the same back (shoulder) edge as the power pins. Pins 1-20 on F.Cu = top side of the board (per project convention); 21-40 on B.Cu = bottom side. Viewed from the top with the card edge up, pin 1 is at the right end and pin 20 at the left; pin 21 is directly under pin 1 and pin 40 under pin 20.")
		(tags "SHARP PC CARTRIDGE CARD EDGE CONNECTOR")
		(property "Reference" "J3"
			(at 3.55 0 0)
