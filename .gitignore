# PSoC Creator build/codegen output -- regenerated by "Build" from the
# schematic (TopDesign) and device configuration, never hand-edited.
**/CortexM3/
**/CortexM0/
**/Generated_Source/
**/codegentemp/
**/Export/

# Build reports/logs -- also regenerated on every build.
*.log
*.rpt
*.cyfit
*_timing.html

# Per-user PSoC Creator IDE state (window layout, MRU lists, etc.) --
# distinct from the shared *.cyprj/*.cywrk project files, which ARE
# tracked.
*.cyprj.*
*.cywrk.*

# Old point-in-time zip snapshots, superseded by real git history.
/Archive/
/Backup/

# sdaslh5801/sdld build output (rom/build.ps1, and the standalone test
# programs under rom/tests/) -- regenerated from the matching .asm source,
# not hand-written. rom_image.h is what main.c actually includes; also
# generated, not hand-written -- run build.ps1 before building the PSoC
# side if rom.asm changed.
**/rom/**/*.ihx
**/rom/**/*.lnk
**/rom/**/*.lst
**/rom/**/*.map
**/rom/**/*.rel
**/rom/**/*.rst
**/rom/**/*.bin
**/rom/rom_image.h
